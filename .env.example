# ============================================================================
# DNSE LIGHTSPEED API CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your actual API credentials
# DO NOT commit .env file to git - it contains sensitive information
#
# Get your API credentials from: https://www.dnse.com.vn/
# Documentation: https://lightspeed-api.dnse.com.vn/docs
# ============================================================================

# DNSE API Endpoints
DNSE_API_URL=https://services.entrade.com.vn/market-data/v1
DNSE_WS_URL=wss://services.entrade.com.vn/ws

# API Credentials (REQUIRED)
# Replace with your actual API key and secret key from DNSE
DNSE_API_KEY=your_api_key_here
DNSE_SECRET_KEY=your_secret_key_here

# ============================================================================
# OPTIONAL CONFIGURATION
# ============================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# API Request Configuration
REQUEST_TIMEOUT=10
MAX_RETRIES=3
RETRY_DELAY=1

# ============================================================================
# NOTES
# ============================================================================
# 1. Never commit your actual .env file to version control
# 2. Keep your API keys secure and do not share them
# 3. API keys should only be used in backend services, never in frontend
# 4. Contact DNSE support if you need to regenerate your API credentials
